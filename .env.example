# ShopSense Application Configuration

# Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopsense_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopsense_test

# Security & JWT Secrets
# Generate a strong 32+ character random secret for production (e.g. using openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-very-strong-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
REFRESH_COOKIE_NAME=shopsense_refresh_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Bootstrap Credentials (Used for one-time initialization)
INITIAL_ADMIN_EMAIL=admin@shopsense.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=Platform Administrator
